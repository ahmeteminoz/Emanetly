rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 8 * 1024 * 1024;
    }

    function isOwnerOfItem(itemId) {
      return isSignedIn() &&
        firestore.get(/databases/(default)/documents/items/$(itemId)).data.lenderId == request.auth.uid;
    }

    match /items/{itemId}/{allPaths=**} {
      allow read: if true;
      allow create, update, delete: if isOwnerOfItem(itemId) && isValidImage();
    }
    
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && request.auth.uid == userId && isValidImage();
    }
  }
}
