rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOwnerOfItem(itemId) {
      return isSignedIn() && get(/databases/$(database)/documents/items/$(itemId)).data.lenderId == request.auth.uid;
    }



    function isVerifiedUser() {
      return isSignedIn()
        && ('email_verified' in request.auth.token)
        && request.auth.token.email_verified == true;
    }

    function isBlockedBetween(userA, userB) {
      return exists(/databases/$(database)/documents/users/$(userA)/blockedUsers/$(userB)) ||
             exists(/databases/$(database)/documents/users/$(userB)/blockedUsers/$(userA));
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && (!('trustScore' in request.resource.data) || request.resource.data.trustScore == 100)
        && (!('reviewCount' in request.resource.data) || request.resource.data.reviewCount == 0)
        && request.resource.data.onboardingComplete == false
        && request.resource.data.usernameSource == "unset"
        && (!('username' in request.resource.data) || request.resource.data.username == null)
        && (!('usernameNormalized' in request.resource.data) || request.resource.data.usernameNormalized == null);

      allow update: if isSignedIn()
        && (
          (
            isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bio', 'department', 'avatarUrl', 'notificationPreferences', 'fcmTokens'])
            && (
              !('notificationPreferences' in request.resource.data) || (
                request.resource.data.notificationPreferences.keys().hasAll(['newMessages', 'newBorrowRequests']) &&
                request.resource.data.notificationPreferences.keys().hasOnly(['newMessages', 'newBorrowRequests']) &&
                request.resource.data.notificationPreferences.newMessages is bool &&
                request.resource.data.notificationPreferences.newBorrowRequests is bool
              )
            )
            && (
              !('fcmTokens' in request.resource.data) || request.resource.data.fcmTokens is list
            )
          )
          ||
          (
            // Other users can submit reviews
            !isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviews', 'averageRating', 'reviewCount'])
            && request.resource.data.reviews is list
            && request.resource.data.reviewCount == (resource.data.reviewCount == null ? 1 : resource.data.reviewCount + 1)
            && (
              resource.data.reviews == null ||
              request.resource.data.reviews.size() == resource.data.reviews.size() + 1
            )
          )
        );

      allow delete: if false;

      // Notifications Subcollection (v0.8.0 - Strict Security Rules with readAt & dismissedAt)
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create, delete: if false; // Only Admin SDK (Cloud Functions) can create/delete
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'dismissedAt']);
      }

      // Blocked Users Subcollection (v0.9.0 - Moderation)
      match /blockedUsers/{blockedUserId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && userId != blockedUserId
          && request.resource.data.blockedUserId == blockedUserId
          && request.resource.data.createdAt is timestamp
          && request.resource.data.source in ['profile', 'chat']
          && request.resource.data.keys().hasOnly(['blockedUserId', 'createdAt', 'source']);
        allow delete: if isOwner(userId);
        allow update: if false;
      }
    }

    // Reports Collection (v0.9.0 - Only Callable Cloud Function writes)
    match /reports/{reportId} {
      allow read, write: if false;
    }

    // UserRelations Collection (v0.9.0 - Two-Way Block Relation Model)
    match /userRelations/{relationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.users;
      allow create, update, delete: if false; // Only Admin SDK (Callable Cloud Function) writes
    }

    // Usernames Collection (v0.9.3 - Enforces uniqueness, only Admin SDK writes)
    match /usernames/{username} {
      allow read, write: if false;
    }

    // 2. Items Collection
    match /items/{itemId} {
      // Draft items can ONLY be read by the lender; published items are public
      allow read: if resource.data.status != 'draft' || (isSignedIn() && resource.data.lenderId == request.auth.uid);

      // Create supports minimal draft schema or full published schema
      allow create: if isVerifiedUser()
        && request.resource.data.lenderId == request.auth.uid
        && (
          // Minimal Draft Schema
          (request.resource.data.status == 'draft')
          ||
          // Full Published Schema
          (
            request.resource.data.title is string
            && request.resource.data.title.size() <= 100
            && request.resource.data.description is string
            && request.resource.data.description.size() <= 3000
            && request.resource.data.status in ['available', 'pendingApproval', 'borrowed', 'pendingReturn', 'archived']
          )
        );

      allow update: if isSignedIn()
        && request.resource.data.lenderId == resource.data.lenderId
        && (!('createdAt' in resource.data) || resource.data.status == 'draft' || request.resource.data.createdAt == resource.data.createdAt)
        // Client cannot transition status to borrowed or archived directly
        && !(request.resource.data.status in ['borrowed', 'archived'])
        // Client cannot set deliveryStatus to delivered directly
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['deliveryStatus'])
            || request.resource.data.deliveryStatus != 'delivered')
        && (
          // Lender can update details or transition draft -> available
          isOwnerOfItem(itemId)
          ||
          // Borrower/Participant updating status fields during active process
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deliveryStatus', 'borrowerId', 'borrowerName', 'meetingPoint'])
            && (
              // Valid State Transition Pairs
              (resource.data.status == 'available' && request.resource.data.status == 'pendingApproval') ||
              (resource.data.status == 'pendingApproval' && request.resource.data.status == 'available') ||
              (resource.data.status == 'borrowed' && request.resource.data.status == 'pendingReturn')
            )
          )
        );

      allow delete: if isOwnerOfItem(itemId) && (resource.data.status == 'available' || resource.data.status == 'draft');
    }

    // 3. BorrowRequests Collection
    match /borrowRequests/{requestId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.ownerId || request.auth.uid == resource.data.requesterId);

      allow create: if isVerifiedUser()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status in ['onlyInquiry', 'pendingDiscussion', 'accepted', 'rejected', 'cancelled', 'expired', 'completed']
        && !isBlockedBetween(request.auth.uid, get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.lenderId);

      allow update: if isSignedIn()
        && (request.auth.uid == resource.data.ownerId || request.auth.uid == resource.data.requesterId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.requesterId == resource.data.requesterId
        && request.resource.data.itemId == resource.data.itemId
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        // Client cannot modify double-confirm timestamps
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'handoverLenderConfirmedAt', 'handoverBorrowerConfirmedAt',
          'returnBorrowerConfirmedAt', 'returnLenderConfirmedAt'
        ])
        && (
          // Requester can only cancel, or upgrade onlyInquiry -> pendingDiscussion
          (
            request.auth.uid == resource.data.requesterId && (
              request.resource.data.status == 'cancelled' ||
              (resource.data.status == 'onlyInquiry' && request.resource.data.status == 'pendingDiscussion')
            )
          )
          ||
          // Owner can accept, reject, or set pendingDiscussion (but NOT complete or borrow directly)
          (request.auth.uid == resource.data.ownerId && request.resource.data.status in ['accepted', 'rejected', 'pendingDiscussion'])
        );

      allow delete: if false;
    }

    // 4. ChatMessages Collection
    match /chatMessages/{messageId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && (request.resource.data.senderId == request.auth.uid || request.resource.data.senderId == 'system')
        && (
          request.resource.data.senderId == 'system' ||
          !isBlockedBetween(
            request.auth.uid,
            get(/databases/$(database)/documents/borrowRequests/$(request.resource.data.requestId)).data.ownerId == request.auth.uid
              ? get(/databases/$(database)/documents/borrowRequests/$(request.resource.data.requestId)).data.requesterId
              : get(/databases/$(database)/documents/borrowRequests/$(request.resource.data.requestId)).data.ownerId
          )
        );

      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.auth.uid != resource.data.senderId;

      allow delete: if false;
    }
  }
}
